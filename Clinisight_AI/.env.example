# Hugging Face access token
HF_TOKEN=

# Tavily web search API key (functions/web_search.py)
TAVILY_API_KEY=

# --- Portkey Gateway (functions/portkey_gateway.py) ---
# Routes LLM calls through a 5-model fallback chain: Ollama Cloud -> Groq ->
# Gemini -> GPT-4o-mini -> Claude Haiku. Get a key at https://app.portkey.ai
PORTKEY_API_KEY=

# Optional: ID of a Portkey dashboard Config implementing the fallback
# strategy. When set, it takes precedence over the in-code FALLBACK_CONFIG.
PORTKEY_CONFIG_ID=

# Ollama Cloud API key - https://ollama.com/settings/keys
OLAMA_TOKEN=

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio API key (Gemini) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- NVIDIA NeMo Guardrails (guardrails/, functions/guardrails.py) ---
# Used only to run the input/output "self check" safety rails around every
# diagnosis/summary prompt and completion — independent of the Portkey
# fallback chain above. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
